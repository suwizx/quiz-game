{
  "name": "@singpore-game/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun --env-file=../../apps/server/.env run src/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@singpore-game/env": "workspace:*",
    "@singpore-game/game-core": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@singpore-game/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
